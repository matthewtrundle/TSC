# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.
#
# Until these three are set, the appointment and contact forms will show an
# honest failure message directing patients to phone the office. They will NOT
# silently pretend to succeed.

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Where form submissions are delivered (the practice's monitored inbox).
PRACTICE_INBOX=office@planoderm.com

# Verified sender address on your Resend domain. Must be a domain you've verified
# in Resend, not a free mailbox — otherwise delivery will fail.
FORM_FROM_ADDRESS=website@planoderm.com
