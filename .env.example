# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.
#
# Until GMAIL_USER and GMAIL_APP_PASSWORD are set, the appointment and contact
# forms will show an honest failure message directing patients to phone the
# office. They will NOT silently pretend to succeed.

# The practice's Google Workspace account the website sends from.
# The practice's Workspace BAA (signed 2018) is what makes this transport
# appropriate for messages that may contain health information — do not
# replace it with a non-BAA sender. Setup on that account:
#   1. Turn on 2-Step Verification (myaccount.google.com > Security)
#   2. Create an App Password (myaccount.google.com/apppasswords), name it
#      "planoderm.com website forms", and paste the 16 characters here.
GMAIL_USER=website@planoderm.com
GMAIL_APP_PASSWORD=

# Where form submissions are delivered. Defaults to office@planoderm.com if
# unset.
PRACTICE_INBOX=office@planoderm.com

# OpenRouter (image generation scripts) — real key lives in .env.local, never committed
OPENROUTER_API_KEY=
